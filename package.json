{
  "name": "@tienne/gestalt",
  "version": "0.94.0",
  "description": "TypeScript AI Development Harness - Gestalt psychology-driven requirement clarification",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tienne/gestalt.git"
  },
  "homepage": "https://github.com/tienne/gestalt#readme",
  "bugs": {
    "url": "https://github.com/tienne/gestalt/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "gestalt": "./dist/bin/gestalt.js",
    "gestalt-hook": "./dist/bin/gestalt-hook.js"
  },
  "files": [
    "dist",
    "plugin",
    "schemas",
    "CLAUDE.md"
  ],
  "scripts": {
    "dev": "tsx bin/gestalt.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "rm -rf dist/plugin && mkdir -p dist/plugin && cp -r plugin/agents plugin/role-agents plugin/review-agents plugin/personas plugin/skills dist/plugin/ && cp -r schemas dist/ && cp package.json dist/ && chmod +x dist/bin/gestalt.js dist/bin/gestalt-hook.js && pnpm run verify:plugin && pnpm run verify:rules && pnpm run verify:rule-overlap && pnpm run verify:output-style && pnpm run verify:routing",
    "verify:plugin": "tsx scripts/verify-plugin-assets.ts",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx bin/gestalt.ts serve",
    "bench": "tsx benchmarks/run.ts",
    "resolution-bench": "tsx benchmarks/run-resolution-benchmark.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "version:sync": "tsx scripts/sync-version.ts",
    "postversion": "pnpm run version:sync && pnpm run build:output-style",
    "verify:rules": "tsx scripts/verify-rule-refs.ts",
    "verify:rule-overlap": "tsx scripts/verify-rule-overlap.ts",
    "gate": "pnpm typecheck && pnpm verify:rules && pnpm verify:rule-overlap && pnpm verify:routing && pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "humanize:baseline": "tsx scripts/humanize-baseline.ts",
    "build:output-style": "tsx scripts/build-output-style.ts",
    "verify:output-style": "tsx scripts/build-output-style.ts --dry-run",
    "build:routing": "tsx scripts/build-skill-routing.ts",
    "verify:routing": "tsx scripts/build-skill-routing.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "elkjs": "^0.12.0",
    "gray-matter": "^4.0.3",
    "node-notifier": "^10.0.1",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "openai": "^6.27.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/node-notifier": "^8.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
