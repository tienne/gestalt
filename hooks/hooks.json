{
  "description": "gestalt 플러그인 훅. 둘 다 기본은 꺼져 있다. 코드 그래프 컨텍스트 자동 주입은 gestalt.json의 codeGraph.hooks.enabled나 GESTALT_CODE_GRAPH_HOOKS=1로 켠다. 그래프 DB가 없는 레포에서는 Node를 띄우지 않고 끝난다. WebFetch 디스크 캐시는 webFetchCache.enabled나 GESTALT_WEBFETCH_CACHE=1로 켠다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/webfetch-cache-hook.sh pre",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/code-graph-hook.sh session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/code-graph-hook.sh user-prompt-submit",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/code-graph-hook.sh post-tool-use",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/webfetch-cache-hook.sh post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/code-graph-hook.sh stop",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
